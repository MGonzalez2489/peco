# Source of truth for API configuration (US-102). Copy to .env and adjust.
# Production NEVER reads these development fallbacks from the application:
# every secret and DATABASE_* value must be supplied by the platform.

# Core
NODE_ENV=development
PORT=3000
TZ=UTC

# MySQL 8 (Dockerized local stack)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=peco
DATABASE_PASSWORD=peco
DATABASE_NAME=peco
DATABASE_ROOT_PASSWORD=root
DATABASE_POOL_SIZE=10
HEALTH_DB_TIMEOUT_MS=1000

# Secrets - development placeholders only; use >=32 distinct chars in every deployed environment
JWT_ACCESS_SECRET=dev-only-access-secret-not-for-production-01
JWT_REFRESH_SECRET=dev-only-refresh-secret-not-for-production-02

# Token durations (<number><s|m|h|d>)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30m
RESET_TOKEN_TTL=45m

# Operational limits (positive integers)
IDEMPOTENCY_TTL_HOURS=24
INACTIVE_USER_DAYS=90
INACTIVE_GRACE_DAYS=7
MAX_BACKFILL_MONTHS=120
CATCHUP_BATCH_SIZE=500
CLEANUP_BATCH_SIZE=1000
AUDIT_LOG_RETENTION_DAYS=730

# Jobs (5-field cron expressions, UTC)
AUTO_APPLY_CRON=5 0 * * *
PERIOD_CLOSE_CRON=10 0 * * *
RECONCILIATION_CRON=0 3 * * *
CLEANUP_CRON=0 4 * * *
JOB_LOCK_TTL_SECONDS=300

# Behaviour
CORS_ORIGINS=http://localhost:8080
# Optional (>=16 chars): allows /metrics from outside the private network
# METRICS_TOKEN=replace-with-a-platform-secret
LOG_LEVEL=info
MAIL_TRANSPORT=capture
RATE_LIMIT_ENABLED=true

# Docker host ports
API_PORT=3000
WEB_PORT=8080
