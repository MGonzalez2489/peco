{
  "name": "@peco/source",
  "version": "0.0.11-a",
  "scripts": {
    "ng": "ng",
    "start": "nx serve web",
    "start:dev": "docker compose up -d mysql && nx serve api",
    "start:dev:api": "nx serve api",
    "build": "nx build web",
    "build:api": "nx build api",
    "watch": "nx build web --watch --configuration development",
    "test": "nx test web --watch=false",
    "test:api": "nx test api",
    "db:show": "TS_NODE_PROJECT=apps/api/tsconfig.app.json node --env-file=.env -r tsconfig-paths/register node_modules/typeorm/cli-ts-node-commonjs.js migration:show -d apps/api/src/app/database/data-source.ts",
    "db:migrate": "TS_NODE_PROJECT=apps/api/tsconfig.app.json node --env-file=.env -r tsconfig-paths/register node_modules/typeorm/cli-ts-node-commonjs.js migration:run -d apps/api/src/app/database/data-source.ts",
    "db:revert": "TS_NODE_PROJECT=apps/api/tsconfig.app.json node --env-file=.env -r tsconfig-paths/register node_modules/typeorm/cli-ts-node-commonjs.js migration:revert -d apps/api/src/app/database/data-source.ts",
    "create-test-data": "node tools/scripts/test-data.js",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
