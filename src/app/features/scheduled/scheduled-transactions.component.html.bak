<section class="space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Programados</h1>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Tus pagos e ingresos recurrentes y su impacto mensual.
      </p>
    </div>

    <button
      type="button"
      (click)="openCreate()"
      class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm shadow-indigo-600/30 transition hover:bg-indigo-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-950"
    >
      <svg
        class="h-4 w-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      <span class="hidden sm:inline">Nuevo programado</span>
      <span class="sm:hidden">Nuevo</span>
    </button>
  </div>

  <div
    class="grid gap-6 rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900 lg:grid-cols-2"
  >
    <div class="space-y-5">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
        Resumen mensual
      </h2>

      <div>
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Impacto neto</p>
        <p class="mt-1 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
          {{ projectedBalance() | currency: 'USD' : 'symbol' : '1.2-2' }}
        </p>
      </div>

      <div class="space-y-3">
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium text-emerald-700 dark:text-emerald-300">Ingresos mensual</span>
          <span class="font-semibold text-emerald-900 dark:text-emerald-200">
            {{ summary().totalIncome | currency: 'USD' : 'symbol' : '1.2-2' }}
          </span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium text-rose-700 dark:text-rose-300">Egresos mensual</span>
          <span class="font-semibold text-rose-900 dark:text-rose-200">
            {{ summary().totalExpenses | currency: 'USD' : 'symbol' : '1.2-2' }}
          </span>
        </div>
      </div>

      <div class="space-y-2">
        <div class="flex items-center justify-between text-sm">
          <span class="font-medium text-slate-600 dark:text-slate-300">% Sueldo comprometido</span>
          <span class="font-semibold text-slate-900 dark:text-white">
            {{ commitmentLabel() }}
          </span>
        </div>
        <div
          class="h-2 w-full overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800"
          role="progressbar"
          [attr.aria-valuenow]="commitmentPercentage()"
          aria-valuemin="0"
          aria-valuemax="100"
          [attr.aria-label]="'Porcentaje de ingresos comprometidos: ' + commitmentLabel()"
        >
          <div
            class="h-full rounded-full transition-all {{ commitmentBarColor() }}"
            [style.width.%]="commitmentPercentage()"
          ></div>
        </div>
      </div>
    </div>

    <div class="space-y-5">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
        Distribución
      </h2>

      @if (categoryDistribution().length === 0) {
        <div
          class="flex h-full min-h-[220px] flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-200 p-6 text-center dark:border-slate-700"
        >
          <p class="text-sm font-medium text-slate-700 dark:text-slate-300">
            No hay egresos programados para el mes.
          </p>
        </div>
      } @else {
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
          <div class="relative mx-auto flex h-48 w-48 items-center justify-center sm:mx-0">
            <svg viewBox="0 0 100 100" class="h-full w-full">
              <circle cx="50" cy="50" r="45" fill="transparent" class="stroke-slate-200 dark:stroke-slate-800" stroke-width="10" />
              @for (segment of donutSegments(); track segment.categoryId) {
                <circle
                  cx="50"
                  cy="50"
                  r="45"
                  fill="transparent"
                  [attr.stroke]="segment.categoryColor"
                  stroke-width="10"
                  stroke-linecap="round"
                  [attr.stroke-dasharray]="segment.dash + ' ' + (2 * Math.PI * 45 - segment.dash)"
                  [attr.stroke-dashoffset]="segment.offset"
                  transform="rotate(-90 50 50)"
                  class="cursor-pointer transition hover:opacity-90"
                  (click)="onCategorySelected(segment.categoryId)"
                  [attr.role]="segment.categoryId === scheduledStore.selectedCategoryId() ? 'button' : 'button'"
                  [attr.aria-pressed]="segment.categoryId === scheduledStore.selectedCategoryId()"
                />
              }
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span class="text-xs text-slate-500 dark:text-slate-400">Total</span>
              <span class="text-lg font-bold text-slate-900 dark:text-white">
                {{ donutTotal() | currency: 'USD' : 'symbol' : '1.2-2' }}
              </span>
            </div>
          </div>

          <div class="flex-1 space-y-2">
            @for (item of categoryDistribution(); track item.categoryId) {
              <button
                type="button"
                (click)="onCategorySelected(item.categoryId)"
                class="flex w-full items-center justify-between gap-3 rounded-xl border px-3 py-2 text-left transition hover:bg-slate-50 dark:hover:bg-slate-800/60"
                [class]="
                  item.categoryId === scheduledStore.selectedCategoryId()
                    ? 'border-indigo-500 bg-indigo-50/60 dark:border-indigo-400 dark:bg-indigo-500/10'
                    : 'border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900'
                "
              >
                <span class="flex min-w-0 items-center gap-2">
                  <span
                    class="h-2.5 w-2.5 shrink-0 rounded-full"
                    [style.background-color]="item.categoryColor"
                  ></span>
                  <span class="truncate text-sm font-medium text-slate-700 dark:text-slate-200">
                    {{ item.categoryName }}
                  </span>
                </span>
                <span class="shrink-0 text-sm font-semibold text-slate-900 dark:text-white">
                  {{ item.percentage }}%
                </span>
              </button>
            }}
            @if (scheduledStore.selectedCategoryId()) {
              <button
                type="button"
                (click)="clearCategoryFilter()"
                class="w-full rounded-xl px-3 py-1.5 text-xs font-semibold text-indigo-600 transition hover:bg-indigo-50 dark:text-indigo-400 dark:hover:bg-indigo-500/10"
              >
                Limpiar selección de categoría
              </button>
            }
          </div>
        </div>
      }
    </div>
  </div>

  <app-scheduled-filter-bar
    (searchChanged)="onSearch($event)"
    (typeFilterChanged)="onTypeFilterChange($event)"
    (categorySelected)="onCategorySelected($event)"
  />

  <div>
    @if (filteredSchedules().length === 0) {
      <div
        class="rounded-2xl border-2 border-dashed border-slate-300 p-8 text-center dark:border-slate-700"
      >
        <p class="text-sm font-medium text-slate-700 dark:text-slate-300">
          No se encontraron movimientos programados con los filtros aplicados.
        </p>
        @if (hasFilters()) {
          <button
            type="button"
            (click)="resetFilters()"
            class="mt-3 inline-flex rounded-xl bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2"
          >
            Limpiar filtros
          </button>
        }
      </div>
    } @else {
      <div class="max-h-[600px] space-y-3 overflow-y-auto pr-2">
        @for (schedule of filteredSchedules(); track schedule.id) {
          <app-scheduled-transaction-card
            [schedule]="schedule"
            (edited)="openEdit($event)"
            (executed)="openExecute($event)"
            (canceled)="cancelOccurrence($event)"
          />
        }
      </div>
    }
  </div>
</section>

<app-scheduled-transaction-form-modal
  [isOpen]="formOpen()"
  [schedule]="scheduleToEdit()"
  (closed)="closeForm()"
/>

<app-execute-schedule-modal
  [isOpen]="executeOpen()"
  [name]="scheduleToExecute()?.name ?? ''"
  [estimatedAmount]="scheduleToExecute()?.estimatedAmount ?? 0"
  (applied)="applyExecution($event)"
  (closed)="closeExecute()"
/>
